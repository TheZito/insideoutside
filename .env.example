# Copy this file to .env and fill in real values. .env is git-ignored.

# SQLite database file path (inside the container / on the named volume).
# Usually fine to leave at the default.
DB_PATH=/data/insideoutside.db

# SMTP relay used to send notification emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=changeme
SMTP_USE_TLS=true

# Where notification emails are sent.
NOTIFY_EMAIL_TO=you@example.com
NOTIFY_EMAIL_FROM=insideoutside@example.com

# How often (minutes) the scheduler runs ingest -> classify -> notify.
POLL_INTERVAL_MINUTES=60

# Dashboard/API bind address inside the container.
HOST=0.0.0.0
PORT=8000
